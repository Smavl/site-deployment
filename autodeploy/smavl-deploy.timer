[Unit]
Description=Poll watched repos every few minutes and redeploy smavl.rocks on change

[Timer]
# Wall-clock schedule: fires every 3 minutes and re-arms deterministically.
# (The earlier monotonic OnBootSec + OnUnitActiveSec pair ran once but did not
# reschedule under the user manager.)
OnCalendar=*:0/3
# Also run shortly after the user manager (re)starts, e.g. a reboot.
OnBootSec=2min
# A little jitter so it isn't exactly on the minute boundary.
RandomizedDelaySec=15s
# Catch up a run missed while the box was off.
Persistent=true

[Install]
WantedBy=timers.target
